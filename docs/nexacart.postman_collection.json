{
  "info": {
    "name": "NexaCart API",
    "description": "Representative end-to-end NexaCart collection. Register/login a customer and an admin first; login scripts store JWTs automatically. Create a category, product, address, and cart item before creating an order. Reviews require an order that an administrator has advanced to DELIVERED. Requests are grouped by area and some flows require prior state; this is not an exhaustive endpoint list.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "customerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@nexacart.local\",\n  \"password\": \"Customer123!\",\n  \"firstName\": \"Maya\",\n  \"lastName\": \"Hassan\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created or already registered', () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@nexacart.local\",\n  \"password\": \"Customer123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nexacart.local\",\n  \"password\": \"ChangeMe_Admin_Dev_123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('admin login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current customer profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Update customer profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Maya\",\n  \"lastName\": \"Hassan\"\n}"
            }
          }
        },
        {
          "name": "Logout customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?page=0&size=20&sort=price,asc&available=true"
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Admin: create category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Category\",\n  \"description\": \"Created from Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('category created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('categoryId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: create product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"name\": \"Postman Demo Product\",\n  \"sku\": \"POSTMAN-DEMO-1\",\n  \"description\": \"Created from Postman\",\n  \"price\": 49.99,\n  \"initialStock\": 25,\n  \"lowStockThreshold\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('product created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Address and Cart",
      "item": [
        {
          "name": "Create address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/addresses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientName\": \"Maya Hassan\",\n  \"line1\": \"42 Demo Street\",\n  \"line2\": \"Apartment 7\",\n  \"city\": \"Cairo\",\n  \"state\": \"Cairo\",\n  \"postalCode\": \"11511\",\n  \"country\": \"Egypt\",\n  \"phone\": \"+20 100 000 0000\",\n  \"defaultAddress\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('address created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('addressId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/addresses"
          }
        },
        {
          "name": "Add product to cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/cart/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/cart"
          }
        },
        {
          "name": "Update cart item quantity",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/cart/items/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" }
          }
        },
        {
          "name": "Clear cart",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/cart"
          }
        }
      ]
    },
    {
      "name": "4. Orders and Payments",
      "item": [
        {
          "name": "Create order (idempotent)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('order created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders?page=0&size=20"
          }
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "Initiate simulated payment",
          "request": {
            "method": "POST",
            "description": "Requires the dev/test payment simulator. The order must be PENDING. Returns the existing pending payment if one already exists.",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('payment initiated', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('paymentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate payment success",
          "request": {
            "method": "POST",
            "description": "Requires the simulator. SUCCESS confirms a PENDING order. Repeating the same terminal outcome is idempotent.",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/simulate",
            "body": { "mode": "raw", "raw": "{\n  \"outcome\": \"SUCCESS\"\n}" }
          }
        },
        {
          "name": "Payment history for order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/payments"
          }
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}"
          }
        },
        {
          "name": "Cancel order",
          "request": {
            "method": "POST",
            "description": "Only PENDING and CONFIRMED orders can be cancelled. If you run the administrator fulfillment requests first, cancellation is rejected; use a new order to exercise this request.",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "5. Reviews",
      "item": [
        {
          "name": "List product reviews",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/reviews"
          }
        },
        {
          "name": "Create review (delivered purchase required)",
          "request": {
            "method": "POST",
            "description": "Requires a DELIVERED order containing this product. Use the admin status requests to advance the order to DELIVERED first.",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/reviews",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"title\": \"Excellent\",\n  \"comment\": \"Exactly as described\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('reviewId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"title\": \"Updated review\",\n  \"comment\": \"Still good\"\n}"
            }
          }
        },
        {
          "name": "Delete my review",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}"
          }
        }
      ]
    },
    {
      "name": "6. Admin",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/users?page=0&size=20"
          }
        },
        {
          "name": "List all orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/orders?page=0&size=20"
          }
        },
        {
          "name": "Admin: get order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}"
          }
        },
        {
          "name": "Admin: order payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}/payments"
          }
        },
        {
          "name": "Advance order to PROCESSING",
          "request": {
            "method": "PATCH",
            "description": "Requires a CONFIRMED order, for example after Simulate payment success. Do not run Cancel order first.",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PROCESSING\"\n}" }
          }
        },
        {
          "name": "Advance order to SHIPPED",
          "request": {
            "method": "PATCH",
            "description": "Requires a PROCESSING order.",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"SHIPPED\"\n}" }
          }
        },
        {
          "name": "Advance order to DELIVERED",
          "request": {
            "method": "PATCH",
            "description": "Requires a SHIPPED order. After this, the customer can create a verified-purchase review.",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"DELIVERED\"\n}" }
          }
        },
        {
          "name": "Get inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/inventory/{{productId}}"
          }
        },
        {
          "name": "Adjust inventory",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/inventory/{{productId}}/stock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": -2,\n  \"reason\": \"Damaged units removed\"\n}"
            }
          }
        },
        {
          "name": "Low stock report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/inventory/low-stock"
          }
        },
        {
          "name": "Inventory transaction history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/inventory/{{productId}}/transactions?page=0&size=20"
          }
        }
      ]
    }
  ]
}
