# Copy this file to .env and change the values for your environment.
# All credentials below are development-only examples. Never use them in production.

POSTGRES_DB=nexacart
POSTGRES_USER=nexacart
POSTGRES_PASSWORD=nexacart_dev_password
DB_PORT=5432
APP_PORT=8080

# Generate with: openssl rand -base64 48
NEXACART_JWT_SECRET=REPLACE_ME_WITH_OPENSSL_RAND_BASE64_48
NEXACART_JWT_ISSUER=nexacart
NEXACART_JWT_TTL_SECONDS=900
NEXACART_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

NEXACART_SHIPPING_FEE=5.99
NEXACART_FREE_SHIPPING_THRESHOLD=100.00
NEXACART_CURRENCY=USD
NEXACART_PAYMENT_SIMULATOR_ENABLED=true
NEXACART_RATE_LIMIT_ENABLED=true
NEXACART_RATE_LIMIT_MAX_ATTEMPTS=10
NEXACART_RATE_LIMIT_WINDOW_SECONDS=60

NEXACART_SEED_ENABLED=true
NEXACART_SEED_CUSTOMER_PASSWORD=Customer123!
NEXACART_ADMIN_EMAIL=admin@nexacart.local
NEXACART_ADMIN_PASSWORD=ChangeMe_Admin_Dev_123!
